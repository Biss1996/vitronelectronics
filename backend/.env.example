# Copy to .env and fill in. Bun loads .env automatically.

# Local Postgres (see README). On DigitalOcean this is injected automatically.
DATABASE_URL=postgres://vitron:vitron@localhost:5432/vitron

# Long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

PORT=4000

# Only needed if the frontend runs on a different domain than the API.
# CORS_ORIGIN=https://vitron.co.ke

# DigitalOcean Spaces for product images. Leave empty locally — images are then
# saved in ./uploads instead.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_PUBLIC_URL=https://your-bucket.fra1.cdn.digitaloceanspaces.com
